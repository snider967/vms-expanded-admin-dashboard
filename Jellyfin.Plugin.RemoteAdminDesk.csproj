<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <JellyfinVersion>12.4.0</JellyfinVersion>
    <PluginDisplayName>VMS Admin Ext. Dash.</PluginDisplayName>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <Version>0.3.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="[$(JellyfinVersion)]" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="[$(JellyfinVersion)]" ExcludeAssets="runtime" />
    <AssemblyMetadata Include="PluginDisplayName" Value="$(PluginDisplayName)" />
    <AssemblyMetadata Include="JellyfinVersion" Value="$(JellyfinVersion)" />
    <EmbeddedResource Include="Pages/desk.html" LogicalName="Jellyfin.Plugin.RemoteAdminDesk.Pages.desk.html" />
  </ItemGroup>
</Project>
